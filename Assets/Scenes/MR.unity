  GUIList:
  - Title: "\u7EA2\u6728\u7B97\u76D8"
    Explain: "\u7EA2\u6728\u7B97\u76D8\u7531\u540D\u8D35\u786C\u6728\u5236\u6210\uFF0C\u91C7\u7528\u4F20\u7EDF\u69AB\u536F\u5DE5\u827A\uFF0C\u65E2\u662F\u53E4\u8001\u7684\u8BA1\u7B97\u5DE5\u5177\uFF0C\u4E5F\u662F\u627F\u8F7D\u5546\u4E1A\u667A\u6167\u7684\u6587\u5316\u8C61\u5F81\u4E0E\u6536\u85CF\u73CD\u54C1\uFF0C\u517C\u987E\u5B9E\u7528\u4E0E\u827A\u672F\u4EF7\u503C\u3002"
    Duration: 10
  - Title: "\u4FA7\u6846"
    Explain: "\u4FA7\u6846\u662F\u7B97\u76D8\u7684\u652F\u6491\u9AA8\u67B6\uFF0C\u7531\u7EB5\u6746\u4E0E\u6A2A\u6881\u62FC\u63A5\u6210\u77E9\u5F62\uFF0C\u4F20\u7EDF\u5DE5\u827A\u4EE5\u6574\u6728\u6316\u5236\u6216\u69AB\u536F\u62FC\u63A5\uFF0C\u65E0\u9489\u54AC\u5408\u56FA\u5B9A\u6863\u6746\uFF0C\u4FDD\u969C\u7ED3\u6784\u7A33\u5B9A\u3002"
    Duration: 14
  - Title: "\u6A2A\u6881"
    Explain: "\u6A2A\u6881\u53C8\u79F0\u4E2D\u6881\uFF0C\u6A2A\u5411\u8D2F\u7A7F\u4FA7\u6846\uFF0C\u662F\u5206\u9694\u4E0A\u4E0B\u7B97\u73E0\u7684\u57FA\u51C6\uFF0C\u8868\u9762\u5D4C\u94DC\u4E1D\u6216\u523B\u51F9\u69FD\u5212\u5206\u8BA1\u6570\u533A\u57DF\uFF0C\u4F5C\u4E3A\u201C\u4E94\u5347\u5341\u8FDB\u5236\u201D\u7684\u89C6\u89C9\u6838\u5FC3\uFF0C\u662F\u7B97\u73E0\u6570\u503C\u5B9A\u4F4D\u3001\u5B9E\u73B0\u7CBE\u51C6\u8BA1\u7B97\u7684\u5173\u952E\u3002"
    Duration: 12.5
  - Title: "\u6863\u6746"
    Explain: "\u6863\u6746\u7EB5\u5411\u5747\u5300\u5206\u5E03\uFF0C\u517113\u6863\u53EF\u5904\u740613\u4F4D\u6570\u5B57\u8BA1\u7B97\uFF0C\u591A\u4E3A\u7AF9\u3001\u94DC\u6216\u786C\u6728\u6750\u8D28\uFF0C\u76F4\u5F84\u7CBE\u51C6\u6253\u78E8\u4E0E\u7B97\u73E0\u5B54\u5F84\u5339\u914D\uFF0C\u8BA9\u7B97\u73E0\u6ED1\u52A8\u987A\u7545\u4E14\u4E0D\u6643\u52A8\u8131\u843D\uFF0C\u662F\u627F\u73E0\u5206\u6863\u7684\u6838\u5FC3\u3002"
    Duration: 12.5
  - Title: "\u7B97\u73E0"
    Explain: "\u7B97\u73E0\u4E3A\u6838\u5FC3\u529F\u80FD\u90E8\u4EF6\uFF0C\u5206\u53CC\u4E0A\u73E0\u3001\u4E94\u4E0B\u73E0\uFF0C\u4E0A\u73E0\u4EE35\u3001\u4E0B\u73E0\u4EE31\u3002"
    Duration: 28
  - Title: "\u5E95\u677F"
    Explain: "\u5E95\u677F\u4E3A\u8F85\u52A9\u7A33\u56FA\u90E8\u4EF6\uFF0C\u8584\u6728\u9576\u5D4C\u5DE5\u827A\u6253\u9020\uFF0C\u8FB9\u7F18\u7559\u900F\u6C14\u5B54\u5E73\u8861\u6E7F\u5EA6\uFF0C\u9632\u6B62\u53D8\u5F62\u5F00\u88C2\uFF0C\u675C\u7EDD\u7B97\u73E0\u8131\u843D\uFF0C\u52A0\u56FA\u6574\u4F53\u7ED3\u6784\uFF0C\u5EF6\u7EED\u5B9E\u7528\u4E3A\u5148\u7684\u8BBE\u8BA1\u7406\u5FF5\u3002"
    Duration: 13
  - Title: "\u7B97\u672F"
    Explain: "\u4E00\u4E0A\u4E00\t\u4E00\u4E0B\u4E94\u53BB\u56DB\t\u4E00\u53BB\u4E5D\u8FDB\u4E00\t"
    Duration: 4.5
  - Title: "\u603B\u7ED3"
    Explain: "\u5982\u4ECA\uFF0C\u8BA1\u7B97\u5668\u4E0E\u667A\u80FD\u8BBE\u5907\u65E9\u5DF2\u666E\u53CA\uFF0C\u4F46\u7B97\u76D8\u5E76\u6CA1\u6709\u56E0\u6B64\u892A\u8272\u3002\u5B83\u662F\u975E\u9057\u6587\u5316\u7684\u9C9C\u6D3B\u7B26\u53F7\uFF0C\u662F\u5320\u4EBA\u7CBE\u795E\u7684\u5177\u8C61\u8868\u8FBE\uFF0C\u66F4\u662F\u4E2D\u56FD\u4EBA\u4E25\u8C28\u52A1\u5B9E\u3001\u7CBE\u6253\u7EC6\u7B97\u7684\u6587\u5316\u56FE\u817E\u3002\u5F53\u6211\u4EEC\u7684\u6307\u5C16\u518D\u6B21\u62E8\u52A8\u7B97\u73E0\uFF0C\u542C\u89C1\u7684\u4E0D\u4EC5\u662F\u73E0\u7389\u76F8\u51FB\u7684\u6E05\u8106\u58F0\u54CD\uFF0C\u66F4\u662F\u53E4\u4ECA\u667A\u6167\u7684\u5BF9\u8BDD\u5171\u9E23\u3002\u8FD9\u628A\u7B97\u76D8\u627F\u8F7D\u7684\uFF0C\u65E2\u662F\u4E00\u6BB5\u5173\u4E8E\u53D1\u660E\u4E0E\u4F20\u627F\u7684\u5386\u53F2\uFF0C\u66F4\u662F\u4E00\u4EFD\u503C\u5F97\u6C38\u8FDC\u73CD\u89C6\u7684\u6587\u5316\u8BB0\u5FC6\u3002\u5B83\u5C06\u7EE7\u7EED\u5728\u65F6\u5149\u4E2D\u6D41\u8F6C\uFF0C\u8BA9\u4F20\u7EDF\u667A\u6167\u7115\u53D1\u6301\u4E45\u7684\u751F\u547D\u529B\u3002"
    Duration: 34
